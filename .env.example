NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/phoneshim"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Docker Compose PostgreSQL settings
POSTGRES_USER="phoneshim"
POSTGRES_PASSWORD="phoneshim-local-password"
POSTGRES_DB="phoneshim"
POSTGRES_PORT=5432

# Change this value in production.
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_ACCESS_EXPIRES_IN="1h"
