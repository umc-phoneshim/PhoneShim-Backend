NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/phoneshim"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Docker Compose PostgreSQL settings
POSTGRES_USER="phoneshim"
POSTGRES_PASSWORD="phoneshim-local-password"
POSTGRES_DB="phoneshim"
POSTGRES_PORT=5432

# Change this value in production.
JWT_ACCESS_SECRET="change-this-access-secret"
JWT_ACCESS_EXPIRES_IN="1h"

# Keep false or unset during Android rollout. Set true after Socket.IO auth is deployed client-side.
SOCKET_AUTH_REQUIRED=false
